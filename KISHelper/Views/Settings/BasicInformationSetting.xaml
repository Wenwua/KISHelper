<UserControl x:Class="KISHelper.Views.Settings.BasicInformationSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KISHelper.Views.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- 账簿 -->
        <GroupBox Header="账簿信息维护" Grid.Row="0" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0">
                    <Button Content="添加" Command="{Binding AddAccountCommand}" Margin="5,0"/>
                    <Button Content="修改" Command="{Binding EditAccountCommand}" Margin="5,0"/>
                    <Button Content="删除" Command="{Binding DeleteAccountCommand}" Margin="5,0"/>
                </ToolBar>

                <DataGrid ItemsSource="{Binding AccountBooks}" AutoGenerateColumns="False" CanUserAddRows="False" Grid.Row="1" IsReadOnly="True"
                          GridLinesVisibility="None" CellStyle="{StaticResource DataGridCellStyle}" RowStyle="{StaticResource DataGridRowStyle}"
                          SelectedItem="{Binding SelectedBook}" MinRowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="账簿编码" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource TextColumnStyle}"/>
                        <DataGridTextColumn Header="账簿名称" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource TextColumnStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 凭证组（结构完全相同） -->
        <GroupBox Header="凭证字信息维护" Grid.Row="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0">
                    <Button Content="添加" Command="{Binding AddVoucherCommand}" Margin="5,0"/>
                    <Button Content="修改" Command="{Binding EditVoucherCommand}" Margin="5,0"/>
                    <Button Content="删除" Command="{Binding DeleteVoucherCommand}"  Margin="5,0"/>
                </ToolBar>

                <DataGrid ItemsSource="{Binding VoucherGroups}" AutoGenerateColumns="False" CanUserAddRows="False" Grid.Row="1" IsReadOnly="True"
                          GridLinesVisibility="None" CellStyle="{StaticResource DataGridCellStyle}" RowStyle="{StaticResource DataGridRowStyle}"
                          SelectedItem="{Binding SelectedVoucher}" MinRowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="凭证字编码" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource TextColumnStyle}"/>
                        <DataGridTextColumn Header="凭证字名称" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource TextColumnStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
