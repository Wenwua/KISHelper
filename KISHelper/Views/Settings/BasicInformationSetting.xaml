<UserControl x:Class="KISHelper.Views.Settings.BasicInformationSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KISHelper.Views.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- 账簿 -->
        <GroupBox Header="账簿信息维护" Grid.Row="0" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0">
                    <Button Content="添加" Command="{Binding AddAccountCommand}"/>
                </ToolBar>

                <DataGrid ItemsSource="{Binding AccountBooks}" AutoGenerateColumns="False" CanUserAddRows="False" Grid.Row="1" IsReadOnly="True"
                          GridLinesVisibility="None" CellStyle="{StaticResource DataGridCellStyle}" RowStyle="{StaticResource DataGridRowStyle}">
                    <DataGrid.Columns>
                        <!-- ID列可编辑 -->
                        <DataGridTextColumn Header="账簿编码" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource TextColumnStyle}"/>
                        <!-- Name列可编辑 -->
                        <DataGridTextColumn Header="账簿名称" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource TextColumnStyle}"/>
                        <!-- 操作列 -->
                        <DataGridTemplateColumn Header="操作" Width="*" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="修改" Margin="2" Padding="5,2"
                                Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                CommandParameter="{Binding}"/>
                                        <Button Content="删除" Margin="2" Padding="5,2"
                                Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 凭证组（结构完全相同） -->
        <GroupBox Header="凭证字信息维护" Grid.Row="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0">
                    <Button Content="添加" Command="{Binding AddVoucherCommand}"/>
                </ToolBar>

                <DataGrid ItemsSource="{Binding VoucherGroups}" AutoGenerateColumns="False" CanUserAddRows="False" Grid.Row="1" IsReadOnly="True"
                          GridLinesVisibility="None" CellStyle="{StaticResource DataGridCellStyle}" RowStyle="{StaticResource DataGridRowStyle}">
                    <DataGrid.Columns>
                        <!-- ID列可编辑 -->
                        <DataGridTextColumn Header="凭证字编码" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource TextColumnStyle}"/>
                        <!-- Name列可编辑 -->
                        <DataGridTextColumn Header="凭证字名称" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource TextColumnStyle}"/>
                        <!-- 操作列 -->
                        <DataGridTemplateColumn Header="操作" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="修改" Margin="2" Padding="5,2"
                    Command="{Binding DataContext.EditVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                    CommandParameter="{Binding}"/>
                                        <Button Content="删除" Margin="2" Padding="5,2"
                    Command="{Binding DataContext.DeleteVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                    CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
