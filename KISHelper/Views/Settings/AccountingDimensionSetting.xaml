<UserControl x:Class="KISHelper.Views.Settings.AccountingDimensionSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KISHelper.Views.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- 账簿 -->
        <GroupBox Header="核算维度维护" Grid.Column="0" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToolBar Grid.Row="0">
                    <Button Content="添加" Command="{Binding AddDimensionCommand}" Margin="5,0" />
                    <Button Content="修改" Command="{Binding EditDimensionCommand}" Margin="5,0" />
                    <Button Content="删除" Command="{Binding DeleteDimensionCommand}" Margin="5,0" />
                    <Button Content="引入" Command="{Binding ImportDimensionCommand}" Margin="5,0"/>
                </ToolBar>

                <DataGrid ItemsSource="{Binding AccDimension}" AutoGenerateColumns="False" CanUserAddRows="False" Grid.Row="1" IsReadOnly="True"
                          GridLinesVisibility="None" CellStyle="{StaticResource DataGridCellStyle}" RowStyle="{StaticResource DataGridRowStyle}"
                          SelectedItem="{Binding SelectedItem}" MinRowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="维度类型" Binding="{Binding DimensionType, UpdateSourceTrigger=LostFocus}" Width="*"/>
                        <DataGridTextColumn Header="维度名称" Binding="{Binding DimensionName, UpdateSourceTrigger=LostFocus}" Width="*"/>
                        <DataGridTextColumn Header="维度编码" Binding="{Binding DimensionNumber, UpdateSourceTrigger=LostFocus}" Width="*"/>
                        <DataGridTextColumn Header="银行科目" Binding="{Binding AccID, UpdateSourceTrigger=LostFocus}" Width="*"/>
                        <DataGridTextColumn Header="银行维度" Binding="{Binding BankDimension, UpdateSourceTrigger=LostFocus}" Width="*"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>
