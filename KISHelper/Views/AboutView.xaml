<UserControl x:Class="KISHelper.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KISHelper.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="LightYellow">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
            <TextBlock Text="仅供内部使用，如有疑问请联系作者" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>
        </StackPanel>

    </Grid>
</UserControl>
