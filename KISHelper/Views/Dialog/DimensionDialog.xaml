<Window x:Class="KISHelper.Views.Dialog.DimensionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="编辑" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">
        <TextBlock Text="维度类型:" Margin="0,0,0,5"/>
        <ComboBox x:Name="TypeBox" Text="{Binding AccDimension.DimensionType}" MinWidth="250" Margin="0,0,0,10">
            <ComboBoxItem Content="客户"/>
            <ComboBoxItem Content="部门"/>
            <ComboBoxItem Content="供应商"/>
            <ComboBoxItem Content="银行账号"/>
        </ComboBox>

        <TextBlock Text="维度名称:" Margin="0,0,0,5"/>
        <TextBox Text="{Binding AccDimension.DimensionName}" MinWidth="250" Margin="0,0,0,15"/>

        <TextBlock Text="维度编码:" Margin="0,0,0,5"/>
        <TextBox Text="{Binding AccDimension.DimensionNumber}" MinWidth="250" Margin="0,0,0,15"/>

        <TextBlock Text="银行科目:" Margin="0,0,0,5"/>
        <TextBox x:Name="AccNumberTextBox" Text="{Binding AccDimension.AccID}" MinWidth="250" Margin="0,0,0,15">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=TypeBox, Path=Text}" Value="银行账号">
                            <Setter Property="IsEnabled" Value="True"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBlock Text="银行维度:" Margin="0,0,0,5"/>
        <TextBox Text="{Binding AccDimension.BankDimension}" MinWidth="250" Margin="0,0,0,15" IsEnabled="{Binding ElementName=AccNumberTextBox, Path=IsEnabled}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" IsDefault="True" Command="{Binding OKCommand}" MinWidth="75" Margin="5,0"/>
            <Button Content="取消" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="75" Margin="5,0"/>
        </StackPanel>
    </StackPanel>
</Window>
