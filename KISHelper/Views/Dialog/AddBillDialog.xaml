<Window x:Class="KISHelper.Views.Dialog.AddBillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="AddBillDialog" SizeToContent="WidthAndHeight">
    <StackPanel Margin="15">
        <TextBlock Text="核算类型:" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding AccRules}" MinWidth="250" Margin="0,0,0,10" DisplayMemberPath="AccName" SelectedItem="{Binding AccRuleSelected}"/>
        <TextBlock Text="部门:" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding DpmDimension}" MinWidth="250" Margin="0,0,0,10" DisplayMemberPath="DimensionName" 
                  SelectedItem="{Binding DpmSelected}" IsEnabled="{Binding AllowDetailID_FFlex5}"/>
        <TextBlock Text="客户:" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding CustomDimension}" MinWidth="250" Margin="0,0,0,10" DisplayMemberPath="DimensionName" 
                  SelectedItem="{Binding CustomSelected}" IsEnabled="{Binding AllowDetailID_FFlex6}"/>
        <TextBlock Text="金额:" Margin="0,0,0,5"/>
        <TextBox Text="{Binding BillInfo.AMOUNT}" MinWidth="250" Margin="0,0,0,10" Height="22"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Content="确定" IsDefault="True" Command="{Binding OKCommand}" MinWidth="75" Margin="5,0"/>
            <Button Content="取消" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="75" Margin="5,0"/>
        </StackPanel>
    </StackPanel>
</Window>
