<Window x:Class="KISHelper.Views.Dialog.AddBankBillInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KISHelper.Views.Dialog"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="资金调拨" SizeToContent="WidthAndHeight">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Margin="15" Orientation="Horizontal">
            <TextBlock Text="调出账号：" VerticalAlignment="Center"/>
            <ComboBox MinWidth="120" ItemsSource="{Binding BankDimension}" DisplayMemberPath="DimensionName" SelectedItem="{Binding OutBankSelected}"/>
        </StackPanel>
        <StackPanel Margin="15" Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="调入账号：" VerticalAlignment="Center"/>
            <ComboBox MinWidth="120" ItemsSource="{Binding BankDimension}" DisplayMemberPath="DimensionName" SelectedItem="{Binding InBankSelected}"/>
        </StackPanel>
        <StackPanel Margin="15" Orientation="Horizontal" Grid.Row="2">
            <TextBlock Text="调拨金额：" VerticalAlignment="Center"/>
            <TextBox MinWidth="120" Text="{Binding Amount}"/>
        </StackPanel>
        <StackPanel Margin="15" Orientation="Horizontal" Grid.Row="3">
            <Button Content="确定" IsDefault="True" Command="{Binding OKCommand}" MinWidth="75" Margin="5,0"/>
            <Button Content="取消" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="75" Margin="5,0"/>
        </StackPanel>
    </Grid>
    
    
</Window>
