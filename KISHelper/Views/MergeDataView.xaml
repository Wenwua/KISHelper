<Window x:Class="KISHelper.Views.MergeDataView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:KISHelper.Views"
        xmlns:vm="clr-namespace:KISHelper.ViewModels"
        mc:Ignorable="d"
        Title="合并数据"
        Height="450"
        Width="800">
    <Window.Resources>
        <vm:BoolToCompareTextConverter x:Key="BoolToText"/>
        <vm:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <x:Array x:Key="CompareOptions"
		         Type="sys:String">
            <sys:String>包含</sys:String>
            <sys:String>等于</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="合并方案"
		          Grid.Row="0"
		          Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,5" Cursor="">
                    <Button Content="合并路径"
                            Command="{Binding SelectPathCommand}"
                            Cursor="Hand"
                            Padding="5"/>
                    <Button Content="{materialDesign:PackIcon Kind=ShapeSquarePlus}"
                            Command="{Binding AddRowCommand}"
                            Padding="8"
                            Margin="5,0"/>
                    <Button Content="{materialDesign:PackIcon Kind=DeleteEmptyOutline}"
                            Command="{Binding DeleteSelectedRowsCommand}"
                            Padding="8"
                            Margin="5,0" Cursor="Hand"/>
                </StackPanel>
                <DataGrid x:Name="Grid" Grid.Row="1"
                          ItemsSource="{Binding SheetStructures}"
                          AutoGenerateColumns="False"
                          EnableRowVirtualization="False"
                          SelectedItem="{Binding SectedItem}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件名"
		                    Binding="{Binding FileName,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
		                    Width="260" IsReadOnly="False"/>

                        <DataGridComboBoxColumn Header="条件"
		                        SelectedItemBinding="{Binding IsContains, Converter={StaticResource BoolToText}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
		                        ItemsSource="{Binding Source={StaticResource CompareOptions}}"
		                        DisplayMemberPath="."/>

                        <DataGridTextColumn Header="工作表序列"
		                    Binding="{Binding SheetIndex , UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
		                    Width="100"/>
                        <DataGridTextColumn Header="类型"
		                    Binding="{Binding AccType , UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
		                    Width="100"/>
                        <DataGridTextColumn Header="字段序列"
		                    Binding="{Binding FieldIndex, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
		                    Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <ProgressBar Grid.Row="1"
		             Margin="5,0"
		             Height="30"
                     Value="{Binding Progress}" Maximum="100"
             IsIndeterminate="False"
             Visibility="{Binding IsRunning,
                          Converter={StaticResource BoolToVisibility}}"/>
        <StackPanel Orientation="Horizontal"
		            Cursor=""
		            Margin="5"
		            Grid.Row="2">
            <Button Content="开始合并" Command="{Binding MergeCommand}" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>