<Window x:Class="KISHelper.Views.Common.AccBookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KISHelper.Views"
        mc:Ignorable="d"
        Title="编辑" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">
        <TextBlock Text="编码:" Margin="0,0,0,5"/>
        <TextBox x:Name="IdBox" Text="{Binding Id}" MinWidth="250" Margin="0,0,0,10"/>

        <TextBlock Text="名称:" Margin="0,0,0,5"/>
        <TextBox x:Name="NameBox" Text="{Binding _Name}" MinWidth="250" Margin="0,0,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" IsDefault="True" Click="Ok_Click" MinWidth="75" Margin="5,0"/>
            <Button Content="取消" IsCancel="True" MinWidth="75" Margin="5,0"/>
        </StackPanel>
    </StackPanel>
</Window>
