<Window x:Class="KISHelper.Views.Common.SheetSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KISHelper.Views.Common"
        mc:Ignorable="d"
        Title="选择工作表" Width="300" Height="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="未找到指定工作表，请手动选择：" Grid.Row="0" Margin="0,0,0,10"/>

        <!-- 工作表列表 -->
        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding SheetNames}" 
                 SelectedItem="{Binding SelectedSheetName}"
                 DisplayMemberPath="."
                 SelectionMode="Single">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="FontSize" Value="14"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="80" IsDefault="True" 
                    Command="{Binding ConfirmCommand}" 
                    IsEnabled="{Binding SelectedSheetName, Converter={StaticResource NullToBooleanConverter}}"/>
            <Button Content="取消" Width="80" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
