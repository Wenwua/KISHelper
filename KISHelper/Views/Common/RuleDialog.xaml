<Window x:Class="KISHelper.Views.Common.RuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KISHelper.Views.Common"
        mc:Ignorable="d"
        Title="编辑" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">
        <TextBlock Text="核算类型:" Margin="0,0,0,5"/>
        <TextBox x:Name="NameBox" Text="{Binding AccName}" MinWidth="250" Margin="0,0,0,10"/>

        <TextBlock Text="科目编码:" Margin="0,0,0,5"/>
        <TextBox x:Name="NumberBox" Text="{Binding AccountID}" MinWidth="250" Margin="0,0,0,15"/>

        <TextBlock Text="方向:" Margin="0,0,0,5"/>
        <ComboBox x:Name="FDCBox" Text="{Binding AccFDC}" MinWidth="250" Margin="0,0,0,15">
            <ComboBoxItem Content="借方"/>
            <ComboBoxItem Content="贷方"/>
        </ComboBox>

        <TextBlock Text="核算维度:" Margin="0,0,0,5"/>
        <TextBox x:Name="FiexItemBox" Text="{Binding AccFiexItem}" MinWidth="250" Margin="0,0,0,15"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" IsDefault="True" Click="Ok_Click" MinWidth="75" Margin="5,0"/>
            <Button Content="取消" IsCancel="True" MinWidth="75" Margin="5,0"/>
        </StackPanel>
    </StackPanel>
</Window>
