<Window x:Class="KISHelper.Views.Common.AddBillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KISHelper.Views.Common"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="AddBillDialog" SizeToContent="WidthAndHeight">
    <StackPanel Margin="15">
        <TextBlock Text="核算类型:" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding AccRules}" MinWidth="250" Margin="0,0,0,10" DisplayMemberPath="AccName" SelectedValuePath="AccName" SelectedValue="{Binding AccType}"/>
        <TextBlock Text="部门:" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding DpmList}" MinWidth="250" Margin="0,0,0,10" DisplayMemberPath="DimensionName" SelectedValuePath="DimensionName" SelectedValue="{Binding DetailID_FFlex5}"/>
        <TextBlock Text="客户:" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding CustomList}" MinWidth="250" Margin="0,0,0,10" DisplayMemberPath="DimensionName" SelectedValuePath="DimensionName" SelectedValue="{Binding DetailID_FFlex6}"/>
        <TextBlock Text="金额:" Margin="0,0,0,5"/>
        <TextBox Text="{Binding AMOUNT}" MinWidth="250" Margin="0,0,0,10" Height="22"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Content="确定" IsDefault="True" Click="Ok_Click" MinWidth="75" Margin="5,0"/>
            <Button Content="取消" IsCancel="True" MinWidth="75" Margin="5,0"/>
        </StackPanel>
    </StackPanel>
</Window>
